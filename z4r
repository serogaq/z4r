#!/bin/sh

# Change this value to switch all project-owned repositories to another owner.
Z4R_GITHUB_OWNER="${Z4R_GITHUB_OWNER:-serogaq}"

Z4R_PROJECT_REPO="${Z4R_PROJECT_REPO:-zapret4rocket}"
Z4R_PROJECT_REF="${Z4R_PROJECT_REF:-master}"
Z4R_LAUNCHER_REPO="${Z4R_LAUNCHER_REPO:-z4r}"
Z4R_LAUNCHER_REF="${Z4R_LAUNCHER_REF:-main}"
Z4R_MIRROR_HOST="${Z4R_MIRROR_HOST:-http://mizulina.shit.vc:666}"

Z4R_PROJECT_SLUG="$Z4R_GITHUB_OWNER/$Z4R_PROJECT_REPO"
Z4R_LAUNCHER_SLUG="$Z4R_GITHUB_OWNER/$Z4R_LAUNCHER_REPO"
Z4R_RAW_BASE="https://raw.githubusercontent.com/$Z4R_PROJECT_SLUG/$Z4R_PROJECT_REF"
Z4R_API_BASE="https://api.github.com/repos/$Z4R_PROJECT_SLUG"
Z4R_MIRROR_BASE="$Z4R_MIRROR_HOST/$Z4R_PROJECT_SLUG/$Z4R_PROJECT_REF"
Z4R_LAUNCHER_RAW_BASE="https://raw.githubusercontent.com/$Z4R_LAUNCHER_SLUG/$Z4R_LAUNCHER_REF"
Z4R_LAUNCHER_MIRROR_BASE="$Z4R_MIRROR_HOST/$Z4R_LAUNCHER_SLUG/$Z4R_LAUNCHER_REF"

API_URL="$Z4R_API_BASE/contents/lib?ref=$Z4R_PROJECT_REF"
INSTALL_DIR="/opt"
LIB_FILES_FALLBACK="repository.sh ui.sh provider.sh telemetry.sh recommendations.sh netcheck.sh premium.sh strategies.sh submenus.sh actions.sh"

# Передаем выбранные репозитории и ветки загруженному z4r.sh.
export Z4R_GITHUB_OWNER Z4R_PROJECT_REPO Z4R_PROJECT_REF
export Z4R_LAUNCHER_REPO Z4R_LAUNCHER_REF Z4R_MIRROR_HOST

# Определение пути для команды z4r
if [ -d /opt/bin ]; then
    BIN_PATH="/opt/bin/z4r"
elif [ -d /usr/local/bin ] && [ -w /usr/local/bin ]; then
    BIN_PATH="/usr/local/bin/z4r"
elif [ -d /usr/bin ] && [ -w /usr/bin ]; then
    BIN_PATH="/usr/bin/z4r"
else
    echo "Ошибка: не найдено подходящее место для установки"
    exit 1
fi

# Проверка прав root для стандартных систем
[ "$UID" != "0" ] && [ ! -d /opt/bin ] && [ ! -d /jffs/scripts ] && {
    echo "Возможно скрипт запущен без прав root (sudo)"
}

# Проверка wget или curl
if which curl >/dev/null 2>&1; then
    DL_CMD="curl -f -sS -L -o"
    DL_TIMEOUT="--connect-timeout 10 --max-time 30"
elif which wget >/dev/null 2>&1; then
    DL_CMD="wget -q -O"
    DL_TIMEOUT="-T 30"
else
    echo "Ошибка: wget или curl не найдены"
    exit 1
fi

# Атомарная загрузка с резервным зеркалом: существующий файл не повреждается,
# если оба источника временно недоступны.
download_url_pair() {
    destination="$1"
    primary_url="$2"
    fallback_url="$3"
    fallback_description="$4"
    temporary_file="${destination}.tmp.$$"

    rm -f "$temporary_file"
    if $DL_CMD "$temporary_file" $DL_TIMEOUT "$primary_url" 2>/dev/null; then
        mv "$temporary_file" "$destination"
        return 0
    fi

    rm -f "$temporary_file"
    echo "GitHub недоступен для $fallback_description. Пробую зеркало..."
    if $DL_CMD "$temporary_file" $DL_TIMEOUT "$fallback_url" 2>/dev/null; then
        mv "$temporary_file" "$destination"
        return 0
    fi

    rm -f "$temporary_file"
    return 1
}

download_project_file() {
    destination="$1"
    path="$2"
    download_url_pair \
        "$destination" \
        "$Z4R_RAW_BASE/$path" \
        "$Z4R_MIRROR_BASE/$path?h=$Z4R_PROJECT_REF" \
        "$path"
}

download_launcher_file() {
    destination="$1"
    path="${2:-z4r}"
    download_url_pair \
        "$destination" \
        "$Z4R_LAUNCHER_RAW_BASE/$path" \
        "$Z4R_LAUNCHER_MIRROR_BASE/$path" \
        "установщика"
}

# Определение откуда запущен скрипт
if which readlink >/dev/null 2>&1; then
    SCRIPT_PATH=$(readlink -f "$0" 2>/dev/null || echo "$0")
elif which realpath >/dev/null 2>&1; then
    SCRIPT_PATH=$(realpath "$0" 2>/dev/null || echo "$0")
else
    SCRIPT_PATH="$0"
fi

# Если запущен из установленной команды - проверяем обновления
if [ "$SCRIPT_PATH" = "$BIN_PATH" ]; then
    echo "Проверка обновлений установщика..."
    TEMP_INSTALLER="/tmp/z4r_inst_$$"

    if download_launcher_file "$TEMP_INSTALLER"; then
        if ! cmp "$SCRIPT_PATH" "$TEMP_INSTALLER" >/dev/null 2>&1; then
            echo "✓ Найдено обновление установщика"
            cp "$TEMP_INSTALLER" "$BIN_PATH"
            chmod +x "$BIN_PATH"
            rm -f "$TEMP_INSTALLER"
            echo "✓ Установщик обновлен, перезапуск..."
            echo ""
            exec "$BIN_PATH" "$@"
        fi
        rm -f "$TEMP_INSTALLER"
    fi
else
    # Первый запуск - установка
    echo "Установка команды z4r в $BIN_PATH..."

    if [ -f "$SCRIPT_PATH" ]; then
        mv "$SCRIPT_PATH" "$BIN_PATH"
    else 
            echo "⚠ Не удалось установить команду z4r"
    fi

    [ -f "$BIN_PATH" ] && chmod +x "$BIN_PATH" && echo "✓ Команда z4r установлена"
    echo ""
fi

echo "=== Обновление zapret4rocket ==="
mkdir -p "${INSTALL_DIR}/zapret/z4r_lib"

# ОПТИМИЗАЦИЯ: Параллельная загрузка списка библиотек
echo "Загрузка компонентов..."
TEMP_JSON="/tmp/z4r_json_$$"

{
    # Загрузка списка библиотек в фоне
    $DL_CMD "$TEMP_JSON" $DL_TIMEOUT "$API_URL" 2>/dev/null || echo "[]" > "$TEMP_JSON"
} &
API_PID=$!

# Ждем завершения загрузки списка библиотек
wait "$API_PID"

# Парсинг JSON
LIB_FILES=$(grep '"name":' "$TEMP_JSON" 2>/dev/null | grep '\.sh"' | sed 's/.*"name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/' | tr '\n' ' ')
if [ -z "$LIB_FILES" ]; then
    LIB_FILES="$LIB_FILES_FALLBACK"
fi

# repository.sh нужен новой версии z4r.sh до загрузки остальных библиотек.
case " $LIB_FILES " in
    *" repository.sh "*) ;;
    *) LIB_FILES="repository.sh $LIB_FILES" ;;
esac
rm -f "$TEMP_JSON"

# Параллельная загрузка z4r.sh и библиотек
echo "Загрузка библиотек..."
{
    # Загрузка основного скрипта в фоне
    if download_project_file "${INSTALL_DIR}/z4r.sh" "z4r.sh"; then
        chmod +x "${INSTALL_DIR}/z4r.sh"
    fi
} &
for file in $LIB_FILES; do
    {
        download_project_file "${INSTALL_DIR}/zapret/z4r_lib/${file}" "lib/${file}"
    } &
done
wait

MISSING_FILES=""
[ -s "${INSTALL_DIR}/z4r.sh" ] || MISSING_FILES="z4r.sh"
for file in $LIB_FILES; do
    [ -s "${INSTALL_DIR}/zapret/z4r_lib/${file}" ] || MISSING_FILES="$MISSING_FILES $file"
done

if [ -n "$MISSING_FILES" ]; then
    echo "Ошибка: не удалось загрузить обязательные компоненты:$MISSING_FILES"
    exit 1
fi

echo "✓ Компоненты загружены"
echo ""

# Запуск z4r.sh
echo "=== Запуск z4r.sh ==="
cd "${INSTALL_DIR}" || exit 1

# Определяем shell
if which bash >/dev/null 2>&1; then
    SHELL_CMD="bash"
elif which ash >/dev/null 2>&1; then
    SHELL_CMD="ash"
else
    SHELL_CMD="sh"
fi

# Перенаправляем stdin на терминал если запущено через pipe
[ -t 0 ] && exec $SHELL_CMD ./z4r.sh "$@" || exec $SHELL_CMD ./z4r.sh "$@" < /dev/tty
